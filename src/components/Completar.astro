---
/**
 * Completar frases: huecos para escribir (___) y opciones para elegir ({a|*b}).
 * La sintaxis de las frases está en scripts/completar-armar.ts.
 *
 * Uso (.mdx):
 *   <Completar titulo="La -s de he/she/it" items={[
 *     { f: 'My sister ___ (watch) TV every day.', r: ['watches'],
 *       e: 'Termina en <b>-ch</b>: se agrega <b>-es</b>.' },
 *     { f: 'They {plays|*play} football.', e: 'Con <b>they</b> el verbo no lleva -s.' },
 *   ]}>
 *     Completá con el verbo en Present Simple.
 *   </Completar>
 */
import ItemsCompletar from './ItemsCompletar.astro';
import { armarItem, codificar, type ItemCompletar } from '../scripts/completar-armar';
import { idEjercicio } from '../scripts/id-ejercicio';

interface Props {
  titulo: string;
  /** ⭐ Lo principal del tema: si hace solo algunos, que sean estos. */
  fundamental?: boolean;
  dificultad?: string;
  items: ItemCompletar[];
}
const { titulo, dificultad = '✏️', items } = Astro.props;
const armados = items.map(armarItem);
const id = idEjercicio(titulo);
---

<section class="completar ejercicio" id={id} data-titulo={titulo}
  data-fundamental={Astro.props.fundamental ? '' : undefined}
  data-solucion={codificar(armados.map((a) => a.solucion))}
  data-expl={codificar(armados.map((a) => a.e || ''))}>
  <header class="ejercicio__header">
    <span class="ejercicio__dif" aria-hidden="true">{dificultad}</span>
    <h3 class="ejercicio__titulo">{titulo}</h3>
    {Astro.props.fundamental && (
      <span class="ejercicio__fundamental" title="Lo principal del tema: si hacés solo algunos, que sean estos">⭐ Fundamental</span>
    )}
    <span class="ej-hecho" hidden>✓ Resuelto</span>
  </header>

  <div class="ejercicio__consigna"><slot /></div>

  <ItemsCompletar items={armados} />

  <div class="ejercicio__acciones">
    <button type="button" class="ejercicio__btn ejercicio__btn--verify" data-verify>✓ Verificar</button>
    <button type="button" class="ejercicio__btn" data-ver hidden>👀 Ver las respuestas</button>
    <button type="button" class="ejercicio__btn ejercicio__btn--reset" data-reset>↺ Borrar todo</button>
  </div>

  <p class="ejercicio__salida" data-salida role="status" aria-live="polite" hidden></p>
</section>

<script>
  import '../scripts/completar';
  import '../scripts/hablar';
</script>
