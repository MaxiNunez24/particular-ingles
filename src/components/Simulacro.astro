---
/**
 * Simulacro de examen: varias partes, se responde todo y se entrega una vez.
 * Recién al entregar se ve la nota, qué estuvo mal, la respuesta correcta y
 * el porqué. Se puede volver a hacer las veces que haga falta.
 *
 * Uso (.mdx):
 *   <Simulacro titulo="Simulacro 1" partes={[
 *     { titulo: 'A. Present Simple', consigna: 'Completá…', items: [ ...como en Completar... ] },
 *   ]} />
 */
import ItemsCompletar from './ItemsCompletar.astro';
import { armarItem, codificar, type ItemCompletar } from '../scripts/completar-armar';
import { idEjercicio } from '../scripts/id-ejercicio';

interface Parte {
  titulo: string;
  consigna?: string;
  items: ItemCompletar[];
}
interface Props {
  titulo: string;
  partes: Parte[];
}
const { titulo, partes } = Astro.props;
const id = idEjercicio(titulo);
const armadas = partes.map((p) => p.items.map(armarItem));
const todas = armadas.flat();
// Dónde arranca la numeración de cada parte: sigue de corrido entre partes.
const desdes = armadas.map((_, i) => 1 + armadas.slice(0, i).reduce((n, a) => n + a.length, 0));
---

<section class="simulacro ejercicio" id={id} data-titulo={titulo}
  data-solucion={codificar(todas.map((a) => a.solucion))}
  data-expl={codificar(todas.map((a) => a.e || ''))}>
  <header class="ejercicio__header">
    <span class="ejercicio__dif" aria-hidden="true">📝</span>
    <h3 class="ejercicio__titulo">{titulo}</h3>
    <span class="ej-hecho" hidden>✓ Aprobado</span>
  </header>
  <p class="simulacro__aviso">
    Como en el examen: respondé todo y tocá <strong>Entregar</strong> al final. Recién ahí vas a ver la nota y
    las correcciones. Lo que escribís se guarda solo, así que podés cortar y seguir después.
  </p>

  {partes.map((p, i) => (
    <div class="simulacro__parte">
      <h4 class="simulacro__parte-tit">{p.titulo}</h4>
      {p.consigna && <p class="simulacro__consigna" set:html={p.consigna} />}
      <ItemsCompletar items={armadas[i]} desde={desdes[i]} />
    </div>
  ))}

  <div class="ejercicio__acciones">
    <button type="button" class="ejercicio__btn ejercicio__btn--verify" data-entregar>📨 Entregar</button>
    <button type="button" class="ejercicio__btn ejercicio__btn--reset" data-reset hidden>↺ Hacerlo de nuevo</button>
  </div>
  <div class="ejercicio__salida simulacro__nota" data-salida role="status" aria-live="polite" hidden></div>
</section>

<script>
  import '../scripts/simulacro';
  import '../scripts/hablar';
</script>
