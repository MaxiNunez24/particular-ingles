---
import { idEjercicio } from '../scripts/id-ejercicio';
/**
 * Ordenar los pasos de un algoritmo (o de un diagrama) hasta que tengan sentido.
 *
 * Es el ejercicio de pensar SIN escribir código: si el orden mental está mal, el
 * código va a estar mal por más que la sintaxis sea perfecta.
 *
 * Se mueve con los botones ▲▼ (que andan en celular y con teclado) y también
 * arrastrando con el mouse.
 *
 * Ejemplo de uso en una página .mdx:
 *
 *   <OrdenarPasos
 *     titulo="Buscar el más alto"
 *     pasos={[
 *       'Guardar el primero como "el más alto hasta ahora"',
 *       'Recorrer los que quedan',
 *       'Si uno es más alto, pasa a ser "el más alto hasta ahora"',
 *       'Al terminar, devolver el que quedó guardado',
 *     ]}
 *     inicial={[2, 4, 1, 3]}
 *   />
 *
 * `pasos` va SIEMPRE en el orden correcto. `inicial` es el desorden con el que
 * arranca (posiciones 1..n del orden correcto). Se escribe a mano a propósito:
 * mezclar al azar en el navegador puede dejarlo resuelto de entrada, y además
 * hace que el ejercicio sea distinto para cada alumno.
 */
interface Props {
  titulo: string;
  /** ⭐ Lo principal de la clase: se hace en clase, y si alguien hace solo algunos, que sean estos. */
  fundamental?: boolean;
  dificultad?: string;
  pasos: string[];
  /** Orden inicial: posiciones (1..n) del orden correcto. Por defecto, al revés. */
  inicial?: number[];
  pistas?: string[];
}

const { titulo, dificultad = '🧩', pasos, inicial, pistas = [] } = Astro.props;

// Al revés es el desorden por defecto: no es el más interesante, pero nunca
// coincide con la solución (salvo con un solo paso, que no sería un ejercicio).
const orden = inicial && inicial.length === pasos.length
  ? inicial
  : pasos.map((_, i) => pasos.length - i);

const id = idEjercicio(titulo);
---

<section class="ordenar" id={id} data-titulo={titulo}
  data-fundamental={Astro.props.fundamental ? '' : undefined}>
  <header class="ejercicio__header">
    <span class="ejercicio__dif" aria-hidden="true">{dificultad}</span>
    <h3 class="ejercicio__titulo">{titulo}</h3>
    {Astro.props.fundamental && (
      <span class="ejercicio__fundamental" title="Lo principal de la clase: si hacés solo algunos, que sean estos">⭐ Fundamental</span>
    )}
    <span class="ej-hecho" hidden>✓ Resuelto</span>
  </header>

  <div class="ejercicio__consigna">
    <slot />
  </div>

  <ol class="ordenar__lista" data-lista>
    {orden.map((pos) => (
      <li class="ordenar__paso" data-idx={String(pos - 1)} draggable="true">
        <span class="ordenar__texto" set:html={pasos[pos - 1]} />
        <span class="ordenar__ok" aria-hidden="true"></span>
        <span class="ordenar__botones">
          <button type="button" class="ordenar__mover" data-subir aria-label="Subir este paso">▲</button>
          <button type="button" class="ordenar__mover" data-bajar aria-label="Bajar este paso">▼</button>
        </span>
      </li>
    ))}
  </ol>

  <div class="ejercicio__acciones">
    <button type="button" class="ejercicio__btn ejercicio__btn--verify" data-verify>✓ Verificar el orden</button>
    <button type="button" class="ejercicio__btn ejercicio__btn--reset" data-reset>↺ Volver a empezar</button>
  </div>

  <p class="ejercicio__salida" data-salida role="status" aria-live="polite" hidden></p>

  {pistas.length > 0 && (
    <details class="ejercicio__pistas">
      <summary>💡 Pistas</summary>
      <ol>
        {pistas.map((p) => <li set:html={p} />)}
      </ol>
    </details>
  )}
</section>

<script>
  import '../scripts/ordenar-pasos.ts';
</script>
